{
  "name": "panita-bot",
  "version": "1.0.0",
  "description": "Discord bot for Panita Web",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "deploy": "ts-node src/scripts/deploy-commands.ts",
    "build": "tsc",
    "postinstall": "prisma generate",
    "test": "node --test -r ts-node/register/transpile-only test/*.test.ts",
    "deploy:prod": "node dist/scripts/deploy-commands.js",
    "smoke:api": "ts-node --transpile-only src/scripts/api-smoke.ts",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "discord-html-transcripts": "^3.2.0",
    "discord.js": "^14.14.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
