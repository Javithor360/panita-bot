generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Photo {
  id          String     @id @default(uuid())
  url         String
  description String?
  enabled     Boolean    @default(true)
  date_taken  DateTime?
  created_at  DateTime   @default(now())
  user_id     Int?
  edition_id  String?
  title       String?
  edition     Edition?   @relation(fields: [edition_id], references: [id])
  user        User?      @relation(fields: [user_id], references: [id])
  categories  Category[] @relation("CategoryToPhoto")
}

model User {
  id             Int            @id @default(autoincrement())
  ign            String?        @unique
  discord_name   String
  discord_id     String         @unique
  password       String?
  enabled        Boolean        @default(false)
  joined_at      DateTime       @default(now())
  trusted_author Boolean        @default(false)
  avatar_url     String?
  photos         Photo[]
  editions       UserEdition[]
  emblems        Emblem[]       @relation("EmblemToUser")
  roles          Role[]         @relation("RoleToUser")
  forms          Form[]         @relation("FormCreator")
  form_responses FormResponse[] @relation("UserFormResponses")
}

model Edition {
  id              String        @id
  name            String
  started_at      DateTime?
  ended_at        DateTime?
  discord_role_id String?       @unique
  synopsis        String?
  theme_color     String?
  emblems         Emblem[]
  photos          Photo[]
  users           UserEdition[]
}

model Category {
  id     String  @id
  name   String
  icon   String?
  color  String?
  photos Photo[] @relation("CategoryToPhoto")
}

model Role {
  id              String  @id @default(uuid())
  name            String
  color           String
  position        Int     @default(0)
  discord_role_id String? @unique
  users           User[]  @relation("RoleToUser")
}

model Emblem {
  id          String   @id
  name        String
  description String?
  icon_url    String?
  position    Int      @default(0)
  edition_id  String?
  edition     Edition? @relation(fields: [edition_id], references: [id])
  users       User[]   @relation("EmblemToUser")
}

model UserEdition {
  id         String    @id @default(uuid())
  user_id    Int
  edition_id   String
  joined_at    DateTime?
  history_text String?
  edition      Edition   @relation(fields: [edition_id], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, edition_id])
}

model TicketPanel {
  id                    String   @id
  guild_id              String
  channel_id            String
  message_id            String
  title                 String
  description           String?
  category_id           String?
  staff_role_id         String?
  ticket_counter        Int      @default(0)
  show_panel_id_in_name Boolean  @default(true)
  tickets               Ticket[]
}

model Ticket {
  id         String      @id @default(uuid())
  panel_id   String
  channel_id String      @unique
  creator_id String
  status     String      @default("OPEN")
  created_at DateTime    @default(now())
  panel      TicketPanel @relation(fields: [panel_id], references: [id], onDelete: Cascade)
}

model Tag {
  id         String   @id @default(uuid())
  name       String   @unique
  content    String?
  media_urls String[]
  author_id  String
  created_at DateTime @default(now())
}

model Form {
  id            String         @id @default(uuid())
  slug          String         @unique
  title         String
  description   String?
  is_open       Boolean        @default(false)
  require_login Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  creator_id    Int
  creator       User           @relation("FormCreator", fields: [creator_id], references: [id])
  sections      FormSection[]
  responses     FormResponse[]
}

model FormSection {
  id          String         @id @default(uuid())
  form_id     String
  title       String?
  description String?
  position    Int            @default(0)
  form        Form           @relation(fields: [form_id], references: [id], onDelete: Cascade)
  questions   FormQuestion[]
}

model FormQuestion {
  id          String       @id @default(uuid())
  section_id  String
  title       String
  description String?
  type        String
  is_required Boolean      @default(false)
  position    Int          @default(0)
  options     Json?
  section     FormSection  @relation(fields: [section_id], references: [id], onDelete: Cascade)
  answers     FormAnswer[]
}

model FormResponse {
  id         String       @id @default(uuid())
  form_id    String
  user_id    Int
  created_at DateTime     @default(now())
  form       Form         @relation(fields: [form_id], references: [id], onDelete: Cascade)
  user       User         @relation("UserFormResponses", fields: [user_id], references: [id], onDelete: Cascade)
  answers    FormAnswer[]

  @@unique([form_id, user_id])
}

model FormAnswer {
  id          String       @id @default(uuid())
  response_id String
  question_id String
  value       String?
  values      String[]
  response    FormResponse @relation(fields: [response_id], references: [id], onDelete: Cascade)
  question    FormQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
}
